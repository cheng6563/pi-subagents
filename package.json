{
  "name": "pi-subagents",
  "version": "0.67.0",
  "description": "Independently maintained generic Pi child executor",
  "author": "Nico Bailon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheng6563/pi-subagents.git"
  },
  "homepage": "https://github.com/cheng6563/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/cheng6563/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "*.mjs",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types test/integration.mts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "prompts": []
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-server": "0.85.0",
    "acorn": "8.18.0",
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "undici": "8.10.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "typescript": "5.9.3",
    "@earendil-works/pi-coding-agent": "file:./test/fixtures/pi-coding-agent-shim"
  }
}
